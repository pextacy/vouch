# Dependencies
node_modules/
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build output. `bundle/` is generated from `ui/` by `pnpm build`; it is
# committed on the publish branch only, because the uploader takes the files
# from disk. Regenerate rather than edit.
bundle/assets/
bundle/fonts/
bundle/index.html
bundle/icon.svg
bundle/anna-tool-ids.js

# CLI state
.anna/

# Local recordings that are not curated fixtures
fixtures/sessions/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Secrets. The app needs none (LLM access is host sampling, no keys), so any
# of these appearing in the tree is a mistake; the repository is public.
.env
.env.*
.npmrc
*.pem
*.key
credentials.json

# Logs, test and coverage output, local recordings
*.log
test-results/
playwright-report/
.coverage
htmlcov/
*.webm
*.mp4

# Local agent settings
.claude/settings.local.json
